{
  "description": "Schema for the post-mass-transfer binary catalog",

  "fields": {
    "System Name": {
      "type": "string | list[string]",
      "description": "Primary identifier(s) for the system"
    },

    "RA": {
      "type": "triplet [err-, value, err+]",
      "units": "deg",
      "description": "Right ascension (ICRS)"
    },

    "Dec": {
      "type": "triplet [err-, value, err+]",
      "units": "deg",
      "description": "Declination (ICRS)"
    },

    "Period": {
      "type": "triplet [err-, value, err+]",
      "units": "days",
      "description": "Orbital period"
    },

    "Eccentricity": {
      "type": "triplet [err-, value, err+]",
      "description": "Orbital eccentricity"
    },

    "M1": {
      "type": "triplet [err-, value, err+]",
      "units": "Msun",
      "description": "Mass of primary component"
    },

    "M2": {
      "type": "triplet [err-, value, err+]",
      "units": "Msun",
      "description": "Mass of secondary component"
    },

    "Mass Function": {
      "type": "triplet [err-, value, err+]",
      "units": "Msun",
      "description": "Spectroscopic mass function"
    },

    "M1_sin3i": {
      "type": "triplet [err-, value, err+]",
      "units": "Msun",
      "description": "M1 sini "
    },


    "M2_sin3i": {
      "type": "triplet [err-, value, err+]",
      "units": "Msun",
      "description": "M2 sini"
    },

  
    "evol_type_1": {
      "type": "string | null",
      "description": "Evolutionary state of component 1 (Table 1)",
      "allowed_values": [
        "MS",
        "HG",
        "RGB",
        "AGB",
        "He-star",
        "WD",
        "NS",
        "BH"
      ]
    },

    "evol_type_2": {
      "type": "string | null",
      "description": "Evolutionary state of component 2 (Table 1)",
      "allowed_values": [
        "MS",
        "HG",
        "RGB",
        "AGB",
        "He-star",
        "WD",
        "NS",
        "BH"
      ]
    },

    "obs_type_1": {
      "type": "string | null",
      "description": "Phenomenological / observational classification of component 1. Free-form string. May include observational classes (e.g. 'Algol', 'EL CVn', 'Be star') or full spectral types in MK notation (e.g. 'B2-3Ve', 'O6 V', 'K3 III', 'WN4').",
      "recommended_values": [
        "Be star",
        "Hot subdwarf",
        "Wolf-Rayet",
        "Blue straggler",
        "sgCH",
        "sBa"
      ],
      "examples": [
        "B2-3Ve",
        "O6 V",
        "WN4",
        "sdB",
        "K3 III"
      ]
    },

    "obs_type_2": {
      "type": "string | null",
      "description": "Phenomenological / observational classification of component 2. Free-form string. May include observational classes (e.g. 'Algol', 'EL CVn', 'Be star') or full spectral types in MK notation (e.g. 'B2-3Ve', 'O6 V', 'K3 III', 'WN4').",
      "recommended_values": [
        "Be star",
        "Hot subdwarf",
        "Wolf-Rayet",
        "Blue straggler",
        "sgCH",
        "sBa"
      ],
      "examples": [
        "B2-3Ve",
        "O6 V",
        "WN4",
        "sdB",
        "K3 III"
      ]
    },


    "system_class": {
      "type": "string",
      "description": "System-level observational class (Table 2)",
      "allowed_values": [
        "Massive contact binary",
        "WUMa binary",
        "Algol",
        "Hot subdwarf binary",
        "He giant",
        "Intermediate-M stripped star",
        "WR binary",
        "Post-AGB binary",
        "EL CVn",
        "Blue straggler binary",
        "Chemically Peculiar",
        "Astrometric WD + MS",
        "Spectroscopic WD + MS",
        "Self-lensing WD + MS",
        "pulsar binary",
        "Spectroscopic compact object",
        "Astrometric compact object",
        "high-mass XRB"
        
      ],
      "notes": "Systems that do not fit any class may propose a new one; see the missing-system submission workflow."
    },

    "quality_flags": {
      "type": "list[string]",
      "description": "Flags for parameters that are assumed, inferred, or otherwise not directly (dynamically) measured. Empty list if all listed parameters are direct measurements.",
      "allowed_values": [
        "assumed_e",
        "assumed_M1",
        "assumed_M2",
        "assumed_q",
        "min_M2",
        "indirect_M1",
        "indirect_M2"
      ],
      "value_descriptions": {
        "assumed_e": "Eccentricity fixed a priori (e.g. e=0 by construction in the light-curve modelling)",
        "assumed_M1": "M1 adopted or assumed rather than measured",
        "assumed_M2": "M2 adopted or assumed rather than measured",
        "assumed_q": "Mass ratio adopted or assumed rather than measured",
        "min_M2": "M2 is a lower limit (e.g. from the mass function assuming i=90 deg)",
        "indirect_M1": "M1 not from orbital dynamics (e.g. photometric, SED, or evolutionary-model estimate; specify the method in Notes)",
        "indirect_M2": "M2 not from orbital dynamics (e.g. photometric, SED, or evolutionary-model estimate; specify the method in Notes)"
      }
    },

    "Detection Method": {
      "type": "list[string]",
      "description": "Detection or characterisation techniques",
      "examples": ["RV", "EB", "SB1", "SB2", "Astrometry", "X-ray"]
    },

    "Reference": {
      "type": "list[string]",
      "description": "ADS bibcodes"
    },

    "Notes": {
      "type": "string | null",
      "description": "Free-form provenance or clarifying notes"
    },

    "Simbad": {
      "type": "string | null",
      "description": "SIMBAD coordinate-based lookup URL"
    }
  }
}
