# %ECSV 1.0
# ---
# datatype:
# - {name: System Name, datatype: string, description: Primary system identifier used in the catalog.}
# - {name: Reference, datatype: string, description: ADS bibcode reference for the measurement.}
# - {name: Notes, datatype: string, description: 'Free-text notes, provenance remarks, and caveats for the entry.'}
# - {name: RA, unit: deg, datatype: float64, description: Right ascension in degrees (scalar).}
# - {name: Dec, unit: deg, datatype: float64, description: Declination in degrees (scalar).}
# - {name: Period_errm, datatype: float64, description: Lower uncertainty for Period.}
# - {name: Period, unit: d, datatype: float64, description: Orbital period in days.}
# - {name: Period_errp, datatype: float64, description: Upper uncertainty for Period.}
# - {name: Eccentricity_errm, datatype: float64, description: Lower uncertainty for Eccentricity.}
# - {name: Eccentricity, datatype: float64, description: Orbital eccentricity.}
# - {name: Eccentricity_errp, datatype: float64, description: Upper uncertainty for Eccentricity.}
# - {name: M1_errm, datatype: float64, description: Lower uncertainty for M1.}
# - {name: M1, unit: solMass, datatype: float64, description: Presumed accretor mass in solar masses.}
# - {name: M1_errp, datatype: float64, description: Upper uncertainty for M1.}
# - {name: M1_sin3i_errm, datatype: float64, description: Lower uncertainty for M1_sin3i.}
# - {name: M1_sin3i, unit: solMass, datatype: float64, description: Projected accretor mass term M1*sin(i)^3.}
# - {name: M1_sin3i_errp, datatype: float64, description: Upper uncertainty for M1_sin3i.}
# - {name: M2_errm, datatype: float64, description: Lower uncertainty for M2.}
# - {name: M2, unit: solMass, datatype: float64, description: Presumed donor mass in solar masses.}
# - {name: M2_errp, datatype: float64, description: Upper uncertainty for M2.}
# - {name: M2_sin3i_errm, datatype: float64, description: Lower uncertainty for M2_sin3i.}
# - {name: M2_sin3i, unit: solMass, datatype: float64, description: Projected donor mass term M2*sin(i)^3.}
# - {name: M2_sin3i_errp, datatype: float64, description: Upper uncertainty for M2_sin3i.}
# - {name: Mass Function_errm, datatype: float64, description: Lower uncertainty for Mass Function.}
# - {name: Mass Function, datatype: float64, description: Binary mass function as reported or derived in the source.}
# - {name: Mass Function_errp, datatype: float64, description: Upper uncertainty for Mass Function.}
# - {name: evol_type_1, datatype: string, description: Assumed evolutionary stage of the accretor.}
# - {name: evol_type_2, datatype: string, description: Assumed evolutionary stage of the donor.}
# - {name: obs_type_1, datatype: string, description: Observed classification of the accretor (for example spectral type).}
# - {name: obs_type_2, datatype: string, description: Observed classification of the donor (for example spectral type).}
# - {name: system_class, datatype: string, description: Class of binary system.}
# - {name: quality_flags, datatype: string, description: Flags marking assumed values and/or minimum/maximum constraints.}
# - {name: pos_err_mas, unit: mas, datatype: float64, description: 1-sigma on-sky positional uncertainty (error-ellipse semi-major axis)
#     in milliarcseconds.}
# - {name: Simbad, datatype: string, description: SIMBAD coordinate-query URL for the source position.}
# meta: !!omap
# - comments: [RA and Dec are scalars in degrees; pos_err_mas is the on-sky positional uncertainty in milliarcseconds., Reference values
#       are ADS bibcodes., Period is in days., M1 is the presumed accretor mass in solar masses., M2 is the presumed donor mass in solar
#       masses., M1_sin3i is the projected mass term of the accretor (M1*sin(i)^3)., M2_sin3i is the projected mass term of the donor
#       (M2*sin(i)^3)., evol_type_1 and evol_type_2 are assumed evolutionary stages for accretor and donor., obs_type_1 and obs_type_2
#       are observational types (for example spectral class) for accretor and donor., system_class is the broad class of binary system.,
#     quality_flags marks entries with assumed values or minimum/maximum constraints.]
# schema: astropy-2.0
"System Name" Reference Notes RA Dec Period_errm Period Period_errp Eccentricity_errm Eccentricity Eccentricity_errp M1_errm M1 M1_errp M1_sin3i_errm M1_sin3i M1_sin3i_errp M2_errm M2 M2_errp M2_sin3i_errm M2_sin3i M2_sin3i_errp "Mass Function_errm" "Mass Function" "Mass Function_errp" evol_type_1 evol_type_2 obs_type_1 obs_type_2 system_class quality_flags pos_err_mas Simbad
