TFORM25 = 'D       '                                                            TTYPE26 = 'Mass Function_errp'                                                  TFORM26 = 'D       '                                                            TTYPE27 = 'evol_type_1'                                                         TFORM27 = '7A      '                                                            TTYPE28 = 'evol_type_2'                                                         TFORM28 = '7A      '                                                            TTYPE29 = 'obs_type_1'                                                          TFORM29 = '21A     '                                                            TTYPE30 = 'obs_type_2'                                                          TFORM30 = '18A     '                                                            TTYPE31 = 'system_class'                                                        TFORM31 = '28A     '                                                            TTYPE32 = 'quality_flags'                                                       TFORM32 = '29A     '                                                            TTYPE33 = 'pos_err_mas'                                                         TFORM33 = 'D       '                                                            TUNIT33 = 'mas     '                                                            TTYPE34 = 'Simbad  '                                                            TFORM34 = '124A    '                                                            COMMENT RA and Dec are scalars in degrees; pos_err_mas is the on-sky positional COMMENT uncertainty in milliarcseconds.                                         COMMENT Reference values are ADS bibcodes.                                      COMMENT Period is in days.                                                      COMMENT M1 is the presumed accretor mass in solar masses.                       COMMENT M2 is the presumed donor mass in solar masses.                          COMMENT M1_sin3i is the projected mass term of the accretor (M1*sin(i)^3).      COMMENT M2_sin3i is the projected mass term of the donor (M2*sin(i)^3).         COMMENT evol_type_1 and evol_type_2 are assumed evolutionary stages for accretorCOMMENT  and donor.                                                             COMMENT obs_type_1 and obs_type_2 are observational types (for example spectral COMMENT class) for accretor and donor.                                          COMMENT system_class is the broad class of binary system.                       COMMENT quality_flags marks entries with assumed values or minimum/maximum constCOMMENT raints.                                                                 COMMENT --BEGIN-ASTROPY-SERIALIZED-COLUMNS--                                    COMMENT datatype:                                                               COMMENT - {name: System Name, datatype: string, description: Primary system id\ COMMENT entifier used in the catalog.}                                          COMMENT - {name: Reference, datatype: string, description: ADS bibcode referen\ COMMENT ce for the measurement.}                                                COMMENT - {name: Notes, datatype: string, description: 'Free-text notes, prove\ COMMENT nance remarks, and caveats for the entry.'}                             COMMENT - {name: RA, unit: deg, datatype: float64, description: Right ascensio\ COMMENT n in degrees (scalar).}                                                 COMMENT - {name: Dec, unit: deg, datatype: float64, description: Declination i\ COMMENT n degrees (scalar).}                                                    COMMENT - {name: Period_errm, datatype: float64, description: Lower uncertaint\ COMMENT y for Period.}                                                          COMMENT - {name: Period, unit: d, datatype: float64, description: Orbital peri\ COMMENT od in days.}                                                            COMMENT - {name: Period_errp, datatype: float64, description: Upper uncertaint\ COMMENT y for Period.}                                                          COMMENT - {name: Eccentricity_errm, datatype: float64, description: Lower unce\ COMMENT rtainty for Eccentricity.}                                              COMMENT - {name: Eccentricity, datatype: float64, description: Orbital eccentr\ COMMENT icity.}                                                                 COMMENT - {name: Eccentricity_errp, datatype: float64, description: Upper unce\ COMMENT rtainty for Eccentricity.}                                              COMMENT - {name: M1_errm, datatype: float64, description: Lower uncertainty fo\ COMMENT r M1.}                                                                  COMMENT - {name: M1, unit: solMass, datatype: float64, description: Presumed a\ COMMENT ccretor mass in solar masses.}                                          COMMENT - {name: M1_errp, datatype: float64, description: Upper uncertainty fo\ COMMENT r M1.}                                                                  COMMENT - {name: M1_sin3i_errm, datatype: float64, description: Lower uncertai\ COMMENT nty for M1_sin3i.}                                                      COMMENT - {name: M1_sin3i, unit: solMass, datatype: float64, description: Proj\ COMMENT ected accretor mass term M1*sin(i)^3.}                                  COMMENT - {name: M1_sin3i_errp, datatype: float64, description: Upper uncertai\ COMMENT nty for M1_sin3i.}                                                      COMMENT - {name: M2_errm, datatype: float64, description: Lower uncertainty fo\ COMMENT r M2.}                                                                  COMMENT - {name: M2, unit: solMass, datatype: float64, description: Presumed d\ COMMENT onor mass in solar masses.}                                             